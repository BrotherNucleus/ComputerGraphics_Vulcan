#version 460
#extension GL_EXT_ray_tracing : enable
#extension GL_EXT_nonuniform_qualifier : enable

struct stHitValue {
	vec3 color;
	bool miss;
	int depth;
	vec3 origin;
	vec3 direction;
	float contribution;
};

layout(location=0) rayPayloadInEXT stHitValue hitValue;

struct DirectionalLight {
	vec3 position;
	vec3 color;
};

struct BufferVertex {
	float x, y, z, nx, ny, nz;
};

struct Vertex {
	vec3 pos;
	vec3 normal;
};

struct BufferMat {
	float dx, dy, dz, ax, ay, az, s, sh, refl;
};

struct Material {
	vec3 diffuse;
	vec3 ambient;
	float specular;
	float shininess;
	float reflective;
};

struct lightBuffer {
	float dx, dy, dz, cx, cy, cz;
};

layout(binding = 0) uniform accelerationStructureEXT topLevelAS;
layout(set = 0, binding = 3) buffer VertexBuffer {
	BufferVertex vertex_buffer[];
};
layout(set = 0, binding = 4) buffer IndexBuffer {
	int posI[];
};
layout(set = 0, binding = 6) buffer MaterialBuffer {
	BufferMat matBuff[];
};
layout(set = 0, binding = 5) uniform Camera {
	mat4 view;
	mat4 proj;
	int samples;
}cam;

layout(set = 0, binding = 7) buffer Light {
	lightBuffer lightBuf;
};

layout(set = 0, binding = 8) buffer vOffset {
	int vOff[];
};

layout(set = 0, binding = 9) buffer iOffset {
	int iOff[];
};

layout(set = 0, binding = 10) buffer mOffset {
	int mOff[];
};

hitAttributeEXT vec2 attribs;

Vertex fetchVertex( int index, int customIndex) {
 	int i = posI[iOff[customIndex] + index];
 	BufferVertex bv = vertex_buffer[vOff[customIndex] + i];
 	Vertex v;
 	v.pos = vec3(bv.x ,bv.y, bv.z);
	v.normal = vec3(bv.nx, bv.ny, bv.nz);
 	return v; 
 }

Material fetchMaterial(int customIndex) {
 	Material m;
 	vec3 dif = vec3(matBuff[mOff[customIndex]].dx, matBuff[mOff[customIndex]].dy, matBuff[mOff[customIndex]].dz);
 	vec3 am = vec3(matBuff[mOff[customIndex]].ax, matBuff[mOff[customIndex]].ay, matBuff[mOff[customIndex]].az);
 	m.diffuse = dif;
 	m.ambient = am;
 	m.specular = matBuff[mOff[customIndex]].s;
 	m.shininess = matBuff[mOff[customIndex]].sh;
	m.reflective = matBuff[mOff[customIndex]].refl;
 	return m;
 }

DirectionalLight fetchLight() {
 	DirectionalLight l;
 	l.position = vec3(lightBuf.dx, lightBuf.dy, lightBuf.dz);
 	l.color = vec3(lightBuf.cx, lightBuf.cy, lightBuf.cz);
 	return l;
 }

void main()
{
	int primitiveID = gl_PrimitiveID;
	int cIndex = gl_InstanceCustomIndexEXT;

	Vertex v0 = fetchVertex(primitiveID*3 + 0, cIndex);
	Vertex v1 = fetchVertex(primitiveID*3 + 1, cIndex);
	Vertex v2 = fetchVertex(primitiveID*3 + 2, cIndex);

	v0.pos = gl_ObjectToWorldEXT * vec4(v0.pos, 1);
	v1.pos = gl_ObjectToWorldEXT * vec4(v1.pos, 1);
	v2.pos = gl_ObjectToWorldEXT * vec4(v2.pos, 1);

	//vec3 normal = normalize(cross(v0.pos - v1.pos, v0.pos - v2.pos));

	float b1 = attribs.x;
    float b2 = attribs.y;
    float b0 = 1.0 - b1 - b2;

	vec3 normal = normalize(b0 * v0.normal + b1 * v1.normal + b2 * v2.normal);
	
	Material mat = fetchMaterial(cIndex);

	vec3 ambient = mat.ambient;

	vec3 hitPos = vec3(gl_WorldRayOriginEXT + gl_RayTmaxEXT * gl_WorldRayDirectionEXT);

	DirectionalLight light = fetchLight();
	vec3 lightDirection = normalize(-hitPos-light.position);
	float lightIntensity = max(dot(normal, lightDirection), 0.0) * 1.5;


	vec3 diffuse = light.color * lightIntensity;
	vec3 surfaceColor = mat.diffuse;

	float shininess = mat.shininess;

	vec4 origin = inverse(cam.view) * vec4(0, 0, 0, 1);
	vec3 o = vec3(origin.x, origin.y, origin.z);
	float specularStrength = mat.specular;
	vec3 viewDir = normalize(o - hitPos);
	vec3 halfwayDir = normalize(lightDirection + viewDir);
	float spec = pow(max(dot(normal, halfwayDir), 0.0), shininess);
	vec3 specular = specularStrength * spec * light.color;

	uint rayFlags = gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsSkipClosestHitShaderEXT;
	float rayMin = 0.001;
	float rayMax = 10000.0;
	float shadowBias = 0.001;
	uint cullMask = 0xFFu;
	vec3 shadowRayOrigin = hitPos+shadowBias*normal;
	vec3 shadowRayDirection=lightDirection;

	hitValue.miss=false;

	//shotshadowray
	//traceRayEXT(topLevelAS,rayFlags,cullMask,0u,0u,0u,shadowRayOrigin,rayMin,shadowRayDirection,rayMax,0);

	float shadow=1.0;
		if(!hitValue.miss )
		{
		shadow=0.1;
		}

	hitValue.color = surfaceColor * (diffuse + ambient + specular);
	//hitValue.color = v1.pos;
	hitValue.origin = hitPos;
	if(mat.reflective < 1.0)
	{
		hitValue.contribution = 0.4;
	}
	hitValue.direction = reflect(gl_WorldRayDirectionEXT, normal);
}